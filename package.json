{
  "name": "campusslot",
  "version": "1.0.0",
  "private": true,
  "description": "CampusSlot - Campus Resource Reservation & Conflict Resolution System",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue.bold,green.bold\" \"npm run server\" \"npm run client\"",
    "build": "npm install --prefix server && npm install --include=dev --prefix client && npm run build --prefix client",
    "start": "npm start --prefix server",
    "seed": "npm run seed --prefix server",
    "test": "npm test --prefix server",
    "client": "npm run dev --prefix client",
    "server": "npm run dev --prefix server"
  },
  "keywords": [
    "campus",
    "booking",
    "resource-reservation",
    "mern",
    "concurrency-control",
    "college-project"
  ],
  "author": "CampusSlot Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
